# Optional overrides for `docker compose`. Copy to .env.docker (git-ignored).
# Nothing here is a secret; the demo needs no credentials.

# Host ports
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Build the backend without ultralytics/torch (stored detections only, ~1 GB smaller)
WITH_YOLO=true

# Must include the URL the browser uses if you change FRONTEND_PORT
CORS_ORIGINS=http://localhost:8080

# Replay start minute: 9000 = day 7 (the held-out TEST day) at 06:00 WIB, morning peak.
# 360 would start on day 1, a training day (predictions there are in-sample).
REPLAY_START_TICK=9000
TICK_INTERVAL_SECONDS=2
LOG_LEVEL=info
